{
  "mcpServers": {
    "tunnel": {
      "type": "http",
      "url": "${TUNNEL_URL}",
      "headers": {
        "Authorization": "Bearer ${TUNNEL_TOKEN}"
      }
    },
    "tunnel-channel": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/channel/tunnel-channel.mjs"],
      "env": {
        "TUNNEL_URL": "${TUNNEL_URL}",
        "TUNNEL_TOKEN": "${TUNNEL_TOKEN}"
      }
    }
  }
}
